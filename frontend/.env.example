# GROTEC FarmerOS Frontend Environment Configuration
#
# In local development, the Vite dev-server proxies '/api' to http://localhost:3000 (see vite.config.ts).
# Default: /api/v1 (relative path, handled by proxy or reverse proxy like Nginx/Vercel)
#
# Target server for Vite dev proxy (/api -> target/api)
# Defaults to http://localhost:3000 (local backend).
# To connect your local frontend directly to the deployed backend without running local backend:
# VITE_BACKEND_PROXY_TARGET=https://grotec-dev-project.onrender.com
VITE_BACKEND_PROXY_TARGET=http://localhost:3000

# Base URL used by the Axios client in the browser:
# Default: /api/v1 (relative path, proxy handles it seamlessly with no CORS issues)
VITE_API_BASE_URL=/api/v1
