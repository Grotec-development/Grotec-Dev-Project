# --- DATABASE CONFIGURATION ---
# All environments use Supabase PostgreSQL. No local/embedded Postgres.
#
# 1. DATABASE_URL: Connection Pooler (Transaction Mode, Port 6543)
#    Format: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# 2. DIRECT_URL: Session-Mode Connection (Port 5432)
#    Format: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# For Supabase self-hosting or direct connection:
#    DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

DATABASE_URL="postgresql://postgres.<PROJECT-REF>:<YOUR-PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<PROJECT-REF>:<YOUR-PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5433/postgres"
# TEST_DATABASE_URL: Tests run against a separate Supabase database or a local Supabase instance.
# For local Supabase: https://supabase.com/docs/guides/local-development
TEST_DATABASE_URL="postgresql://postgres:<password>@127.0.0.1:54322/postgres"
PORT=3000
CORS_ORIGINS="http://localhost:5173"
JWT_ACCESS_SECRET="dev-only-change-me-access-secret"
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# How long a session may sit with no authenticated request before the next
# /auth/refresh is refused and the session revoked (see AuthService#rotateSession).
SESSION_IDLE_TIMEOUT_SECONDS=900
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
FOUNDER_EMAIL="founder@grotec.local"
FOUNDER_NAME="Grotec Founder"
FOUNDER_PASSWORD="Founder@123"
SEED_EMPLOYEES="Manager One,manager@grotec.local,MANAGER;Agent One,agent@grotec.local,AGENT;Staff One,staff@grotec.local,STAFF;Delivery One,delivery@grotec.local,DELIVERY"
ESSL_WEBHOOK_SECRET="dev-essl-webhook-secret"

# --- Auto-dialer (Month 2) ---
DIALER_PROVIDER=mock
DIALER_RING_MS=4000
DIALER_CONNECT_MS=800
DIALER_ANSWER_RATE=1
DIALER_SYNC_MS=1500
DIALER_WEBHOOK_SECRET=dev-webhook-secret-change-me

# --- Exotel IVRS cum Agent Dialer & Phone Messages (SMS) ---
EXOTEL_ACCOUNT_SID=""
EXOTEL_API_KEY=""
EXOTEL_API_TOKEN=""
EXOTEL_SUBDOMAIN="api.exotel.com"
EXOTEL_CALLER_ID="08000000000"
EXOTEL_SMS_SENDER_ID="08000000000"
EXOTEL_APP_ID=""
EXOTEL_FLOW_URL=""
EXOTEL_WEBHOOK_URL=""

# --- WhatsApp Business / Cloud API ---
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_API_VERSION="v19.0"

# --- SMTP Email Configuration ---
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="\"GROTEC FarmerOS\" <notifications@grotec.local>"


# --- GROTEC AI ASSISTANT (100% Free AI Providers) ---
# Option 1: Groq (Recommended: 100% Free, ultra-fast 250+ tokens/sec, no credit card needed)
# Free Key at: https://console.groq.com/keys
LLM_BASE_URL="https://api.groq.com/openai/v1"
LLM_MODEL="llama-3.3-70b-versatile"
LLM_API_KEY="gsk_your_free_groq_api_key_here"

