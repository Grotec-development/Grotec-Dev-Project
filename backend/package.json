{
  "name": "@grotec/backend",
  "version": "0.1.0",
  "private": true,
  "description": "GROTEC FarmerOS CRM — NestJS REST API",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node -r @swc-node/register src/main.js",
    "start:prod": "node dist/main.js",
    "start:dev": "node --watch-path=src -r @swc-node/register src/main.js",
    "dev": "npm run start:dev",
    "prestart:dev": "npm run build --workspace @grotec/shared",
    "test": "npm run build --workspace @grotec/shared && vitest run",
    "test:watch": "vitest",
    "prisma:migrate-dev": "prisma migrate dev",
    "prisma:migrate-deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "seed": "node prisma/seed.js"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@grotec/shared": "*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^7.4.2",
    "@prisma/client": "^6.2.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "nodemailer": "^10.0.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.15",
    "@swc/core": "^1.16.1",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^6.0.2",
    "dotenv": "^16.4.7",
    "prisma": "^6.2.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3",
    "unplugin-swc": "^1.5.11",
    "vitest": "^2.1.8"
  }
}
