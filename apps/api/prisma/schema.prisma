// GROTEC FarmerOS CRM — Month 1 foundation schema.
// Conventions: UUID PKs, snake_case columns, timestamptz timestamps,
// soft delete via deleted_at on business records, append-only ownership/audit rows.
// Partial unique indexes (active-row uniqueness) are added via raw SQL in the
// init migration — Prisma schema cannot express partial indexes.
// See docs/database.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums (mirrored in packages/shared/src/enums.ts)
// ---------------------------------------------------------------------------

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum EmployeeEmploymentStatus {
  ACTIVE
  PROBATION
  ON_LEAVE
  TERMINATED
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum PhoneKind {
  MOBILE
  OTHER
}

// Provisional vocabulary — reconciled with the Month 3 call-outcome flow
// (docs/open-items.md #5).
enum LeadStatus {
  OPEN
  CLOSED
}

// Canonical call states (PRD §6.3.3) — the final list is provider-dependent
// (open item); these canonical states are what providers map onto.
enum CallStatus {
  DIALING
  RINGING
  CONNECTED
  ENDED
  NOT_ANSWERED
  FAILED
}

enum CallDirection {
  OUTBOUND
}

// Exactly three call outcomes (PRD §6.3.6) — Outcome and Next Action are
// separate fields and must never be merged into one status column (§11.1).
enum CallOutcome {
  INTERESTED
  NOT_INTERESTED
  NOT_ANSWERED
}

// Next Action for an Interested outcome (PRD §6.3.7): exactly one, no default.
enum NextAction {
  CALLBACK
  SALES
}

// Follow-up lifecycle (provisional — vocabulary not fixed by the PRD).
enum FollowUpStatus {
  PENDING
  COMPLETED
  CANCELLED
}

// Outbound message lifecycle (integration failures surfaced, never silent).
enum MessageStatus {
  PENDING
  SENT
  FAILED
}

enum MessageType {
  PRODUCT_DETAILS
}

// ---------------------------------------------------------------------------
// Identity & RBAC
// ---------------------------------------------------------------------------

// Single shared employee identity (future HRMS extends this table; it is never
// duplicated into a CRM-only user table). Emails are stored lowercase.
model Employee {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(255)
  fullName     String   @map("full_name")
  phone        String?  @db.VarChar(20)
  passwordHash String   @map("password_hash")
  roleId       String   @map("role_id") @db.Uuid
  role         Role     @relation(fields: [roleId], references: [id])
  status       EmployeeStatus @default(ACTIVE)
  lastLoginAt  DateTime? @map("last_login_at")
  createdById  String?  @map("created_by") @db.Uuid
  createdBy    Employee? @relation("EmployeeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  employeeCode String?  @unique @map("employee_code") @db.VarChar(30)
  designation  String?  @db.VarChar(100)
  department   String?  @db.VarChar(100)
  reportingManagerId String? @map("reporting_manager_id") @db.Uuid
  reportingManager Employee? @relation("EmployeeManager", fields: [reportingManagerId], references: [id], onDelete: SetNull)
  subordinates   Employee[] @relation("EmployeeManager")
  joiningDate    DateTime? @map("joining_date") @db.Date
  experience     String?  @db.VarChar(50)
  address        String?
  notes          String?
  employmentStatus EmployeeEmploymentStatus? @default(ACTIVE) @map("employment_status")

  createdEmployees  Employee[]       @relation("EmployeeCreatedBy")
  createdCustomers  Customer[]       @relation("CustomerCreatedBy")
  createdGuidance   CropProductGuidance[] @relation("GuidanceCreatedBy")
  sessions          AuthSession[]
  audits            AuditEvent[]
  heldLeadOwnerships LeadOwnership[]  @relation("LeadOwnershipHolder")
  assignedLeadOwnerships LeadOwnership[] @relation("LeadOwnershipAssignedBy")
  placedCalls       Call[]           @relation("CallPlacedBy")
  writtenCallNotes  CallNote[]       @relation("CallNoteAuthor")
  ownedFollowUps    FollowUp[]       @relation("FollowUpOwner")
  heldRelationshipOwnership RelationshipOwnership[] @relation("RelationshipOwnershipHolder")
  assignedRelationshipOwnership RelationshipOwnership[] @relation("RelationshipOwnershipAssignedBy")
  writtenCustomerNotes CustomerNote[] @relation("CustomerNoteAuthor")
  documents         EmployeeDocument[]
  uploadedDocuments EmployeeDocument[] @relation("DocUploadedBy")
  writtenEmployeeNotes EmployeeNote[]  @relation("EmployeeNoteAuthor")
  employeeNotes        EmployeeNote[]  @relation("EmployeeNotes")
  staffAssignments     EmployeeAssignment[] @relation("StaffAssignment")
  assignedStaffs       EmployeeAssignment[] @relation("AssignedToStaff")
  historyRecords    EmployeeHistoryRecord[]
  attendanceRecords AttendanceRecord[]
  leaveApplications LeaveApplication[]
  leaveBalances     LeaveBalance[]
  salaryRevisions   SalaryRevision[]
  advances          AdvanceLedger[]
  payrollLineItems  PayrollLineItem[]
  kpiTargets        KpiTarget[]
  kpiPeriodScores   KpiPeriodScore[]
  esslDeviceMappings EsslDeviceMapping[]
  notifications     AppNotification[]

  @@map("employees")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(30)
  name        String   @db.VarChar(100)
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  employees      Employee[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(100)
  module      String   @db.VarChar(60)
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// Refresh-token store. Tokens are stored hashed; rotation revokes the old row.
model AuthSession {
  id         String   @id @default(uuid()) @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tokenHash  String   @map("token_hash")
  expiresAt  DateTime @map("expires_at")
  ip         String?
  userAgent  String?  @map("user_agent")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([employeeId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

// ---------------------------------------------------------------------------
// Farmer master
// ---------------------------------------------------------------------------

model Customer {
  id         String         @id @default(uuid()) @db.Uuid
  // Unique Farmer ID (developer brief farmer-master list) — e.g. GF00000042,
  // generated from farmer_code_seq. Nullable only for pre-alignment rows.
  farmerCode String?        @unique @map("farmer_code") @db.VarChar(20)
  fullName   String         @map("full_name")
  status     CustomerStatus @default(ACTIVE)
  // Preferred language is provisional; vocabulary TBD (open item).
  preferredLanguage String? @map("preferred_language") @db.VarChar(10)
  createdById String?       @map("created_by") @db.Uuid
  createdBy  Employee?      @relation("CustomerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  deletedAt  DateTime?      @map("deleted_at")

  phones    CustomerPhone[]
  locations CustomerLocation[]
  crops     CustomerCrop[]
  leads     Lead[]
  calls     Call[]
  followUps FollowUp[]
  relationshipOwnership RelationshipOwnership[]
  outboundMessages OutboundMessage[]
  notes     CustomerNote[]

  @@index([fullName])
  @@map("customers")
}

model CustomerPhone {
  id         String    @id @default(uuid()) @db.Uuid
  customerId String    @map("customer_id") @db.Uuid
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  phoneE164  String    @map("phone_e164") @db.VarChar(20)
  rawInput   String?   @map("raw_input")
  kind       PhoneKind @default(MOBILE)
  isPrimary  Boolean   @default(false) @map("is_primary")
  createdById String?  @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  @@index([customerId])
  @@map("customer_phones")
}

model CustomerLocation {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  addressLine String? @map("address_line")
  state      String?
  district   String?
  taluk      String?
  village    String?
  pincode    String?
  latitude   Decimal? @db.Decimal(9, 6)
  longitude  Decimal? @db.Decimal(9, 6)
  isPrimary  Boolean  @default(false) @map("is_primary")
  createdById String? @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  @@index([customerId])
  @@map("customer_locations")
}

model Crop {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(40)
  name        String   @db.VarChar(120)
  localName   String?  @map("local_name")
  category    String?  @db.VarChar(40) // field | tree | plantation | vegetable | other (PRD §6.5.2)
  isActive    Boolean  @default(true) @map("is_active")
  createdById String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  customerCrops CustomerCrop[]
  guidance      CropProductGuidance[]

  @@map("crops")
}

// ---------------------------------------------------------------------------
// AI Assistant knowledge (replaces the Knowledge Base screen)
// ---------------------------------------------------------------------------
// Structured crop → problem/symptom → recommended Grotec product guidance used
// as retrieval context for the assistant chat. Founder/Manager curate rows;
// Agents/telecallers reach them read-only through the chatbot.
model CropProductGuidance {
  id                  String   @id @default(uuid()) @db.Uuid
  cropId              String   @map("crop_id") @db.Uuid
  crop                Crop     @relation(fields: [cropId], references: [id], onDelete: Restrict)
  problemType         String?  @map("problem_type") // pest | disease | nutrient_deficiency | weed | other (PRD §6.5.2)
  problemKeywords     String[] @map("problem_keywords")
  recommendedProducts String[] @map("recommended_products")
  usageGuidance       String?  @map("usage_guidance")
  notes               String?
  isActive            Boolean  @default(true) @map("is_active")
  createdById         String?  @map("created_by") @db.Uuid
  createdBy           Employee? @relation("GuidanceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@index([cropId])
  @@index([problemType])
  @@map("crop_product_guidance")
}

model CustomerCrop {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  cropId     String   @map("crop_id") @db.Uuid
  crop       Crop     @relation(fields: [cropId], references: [id], onDelete: Restrict)
  acreage    Decimal  @db.Decimal(12, 2)
  unit       String   @default("acre") @db.VarChar(20)
  notes      String?
  createdById String? @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  @@index([customerId])
  @@index([cropId])
  @@map("customer_crops")
}

// ---------------------------------------------------------------------------
// Leads + agent ownership
// ---------------------------------------------------------------------------

model Lead {
  id         String     @id @default(uuid()) @db.Uuid
  customerId String     @map("customer_id") @db.Uuid
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  source     String?    // taxonomy provisional (open-item #5)
  status     LeadStatus @default(OPEN)
  notes      String?
  createdById String?   @map("created_by") @db.Uuid
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  deletedAt  DateTime?  @map("deleted_at")

  ownerships LeadOwnership[]
  calls      Call[]
  followUps  FollowUp[]

  @@index([customerId])
  @@index([status])
  @@map("leads")
}

// Agent ownership history. A lead has exactly one CURRENT owner (partial unique
// index on released_at IS NULL — added in the init migration). Rows are never
// deleted. Distinct concept from relationship ownership (RM, Month 4).
model LeadOwnership {
  id           String   @id @default(uuid()) @db.Uuid
  leadId       String   @map("lead_id") @db.Uuid
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Restrict)
  employeeId   String   @map("employee_id") @db.Uuid
  employee     Employee @relation("LeadOwnershipHolder", fields: [employeeId], references: [id], onDelete: Restrict)
  assignedById String   @map("assigned_by") @db.Uuid
  assignedBy   Employee @relation("LeadOwnershipAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)
  reason       String?
  assignedAt   DateTime @default(now()) @map("assigned_at")
  releasedAt   DateTime? @map("released_at")

  @@index([leadId])
  @@index([employeeId])
  @@map("lead_ownership")
}

// ---------------------------------------------------------------------------
// Calls — agent calling workspace (Month 2)
// ---------------------------------------------------------------------------
// One row per dialed outbound call. The call keeps its normalized phone number
// independently of any customer so a call can exist (and continue) while a
// customer record is being created/attached mid-call (PRD §6.3.5).
// outcome/nextAction arrive in Month 3 and are deliberately absent here.
model Call {
  id            String        @id @default(uuid()) @db.Uuid
  customerId    String?       @map("customer_id") @db.Uuid
  customer      Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  leadId        String?       @map("lead_id") @db.Uuid
  lead          Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  agentId       String        @map("agent_id") @db.Uuid
  agent         Employee      @relation("CallPlacedBy", fields: [agentId], references: [id], onDelete: Restrict)
  phoneNumber   String        @map("phone_number") @db.VarChar(20)
  direction     CallDirection @default(OUTBOUND)
  status        CallStatus
  outcome       CallOutcome?  // PRD §6.3.6/§11.1 — outcome and next action stay separate
  nextAction    NextAction?   @map("next_action")
  provider      String        @db.VarChar(40)
  providerCallId String       @unique @map("provider_call_id") @db.VarChar(120)
  startedAt     DateTime      @default(now()) @map("started_at")
  connectedAt   DateTime?     @map("connected_at")
  endedAt       DateTime?     @map("ended_at")
  disconnectReason String?    @map("disconnect_reason") @db.VarChar(40)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  notes         CallNote[]
  followUps     FollowUp[]
  outboundMessages OutboundMessage[]

  @@index([agentId, startedAt])
  @@index([customerId, startedAt])
  @@index([leadId])
  @@index([phoneNumber])
  @@index([status])
  @@index([outcome])
  @@map("calls")
}

model CallNote {
  id        String   @id @default(uuid()) @db.Uuid
  callId    String   @map("call_id") @db.Uuid
  call      Call     @relation(fields: [callId], references: [id], onDelete: Cascade)
  authorId  String   @map("author_id") @db.Uuid
  author    Employee @relation("CallNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([callId])
  @@map("call_notes")
}

// ---------------------------------------------------------------------------
// Call outcomes + follow-ups + sales handoff (Month 3)
// ---------------------------------------------------------------------------

model FollowUp {
  id          String         @id @default(uuid()) @db.Uuid
  customerId  String         @map("customer_id") @db.Uuid
  customer    Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  callId      String?        @map("call_id") @db.Uuid
  call        Call?          @relation(fields: [callId], references: [id], onDelete: SetNull)
  leadId      String?        @map("lead_id") @db.Uuid
  lead        Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  agentId     String         @map("agent_id") @db.Uuid
  agent       Employee       @relation("FollowUpOwner", fields: [agentId], references: [id], onDelete: Restrict)
  dueAt       DateTime       @map("due_at")
  note        String
  status      FollowUpStatus @default(PENDING)
  completedAt DateTime?      @map("completed_at")
  reminderSentAt DateTime?     @map("reminder_sent_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@index([agentId, dueAt])
  @@index([customerId, dueAt])
  @@index([status, dueAt])
  @@map("follow_ups")
}

// RM (relationship) ownership — a distinct concept from lead ownership (§6.4,
// §11.1). A customer has exactly one CURRENT RM (partial unique index on
// released_at IS NULL, added in the migration). Rows are never deleted.
model RelationshipOwnership {
  id           String   @id @default(uuid()) @db.Uuid
  customerId   String   @map("customer_id") @db.Uuid
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  employeeId   String   @map("employee_id") @db.Uuid
  employee     Employee @relation("RelationshipOwnershipHolder", fields: [employeeId], references: [id], onDelete: Restrict)
  assignedById String   @map("assigned_by") @db.Uuid
  assignedBy   Employee @relation("RelationshipOwnershipAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)
  reason       String?
  assignedAt   DateTime @default(now()) @map("assigned_at")
  releasedAt   DateTime? @map("released_at")

  @@index([customerId])
  @@index([employeeId])
  @@map("relationship_ownership")
}

// Automatic product communication on an Interested outcome (§6.3.10). Every
// attempt is recorded; the real channel/provider arrives behind MessagingProvider.
model OutboundMessage {
  id                String        @id @default(uuid()) @db.Uuid
  customerId        String        @map("customer_id") @db.Uuid
  customer          Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  callId            String?       @map("call_id") @db.Uuid
  call              Call?         @relation(fields: [callId], references: [id], onDelete: SetNull)
  type              MessageType   @default(PRODUCT_DETAILS)
  provider          String        @db.VarChar(40)
  providerMessageId String?       @map("provider_message_id") @db.VarChar(120)
  recipientPhone    String        @map("recipient_phone") @db.VarChar(20)
  body              String
  status            MessageStatus @default(PENDING)
  error             String?       @db.VarChar(500)
  attempts          Int           @default(0)
  createdAt         DateTime      @default(now()) @map("created_at")
  sentAt            DateTime?     @map("sent_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  @@index([customerId])
  @@index([status])
  @@map("outbound_messages")
}

// ---------------------------------------------------------------------------
// Customer notes (RM workspace, Month 4)
// ---------------------------------------------------------------------------

model CustomerNote {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  authorId   String   @map("author_id") @db.Uuid
  author     Employee @relation("CustomerNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  body       String
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([customerId])
  @@map("customer_notes")
}

// ---------------------------------------------------------------------------
// Audit (append-only)
// ---------------------------------------------------------------------------

model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  actorId     String?  @map("actor_id") @db.Uuid
  actor       Employee? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  entityType  String   @map("entity_type") @db.VarChar(60)
  entityId    String?  @map("entity_id") @db.Uuid
  entityLabel String?  @map("entity_label")
  action      String   @db.VarChar(60)
  before      Json?    @db.JsonB
  after       Json?    @db.JsonB
  meta        Json?    @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("audit_events")
}

// ---------------------------------------------------------------------------
// HRMS Enums
// ---------------------------------------------------------------------------

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  WEEKLY_OFF
  HOLIDAY
  LEAVE
}

enum AttendanceSource {
  ESSL
  MANUAL
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum EmployeeHistoryType {
  TRAINING
  WARNING
  COMMENDATION
  PROMOTION
}

enum PayrollStatus {
  IDLE
  GENERATED
  APPROVED_LOCKED
  PUBLISHED
}

enum KpiMetricType {
  CALLS_DIALED
  CALLS_CONNECTED
  LEADS_CONVERTED
  CONVERSION_RATE
  TOTAL_REVENUE
  CUSTOMER_QUALITY
  ATTENDANCE
  CRM_DISCIPLINE
}

enum NotificationType {
  FOLLOW_UP_REMINDER
  PRODUCT_DETAILS
  ATTENDANCE_STATUS
  LEAVE_STATUS
  PAYROLL_STATUS
}

// ---------------------------------------------------------------------------
// HRMS Models
// ---------------------------------------------------------------------------

model EmployeeDocument {
  id            String    @id @default(uuid()) @db.Uuid
  employeeId    String    @map("employee_id") @db.Uuid
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  fileName      String    @map("file_name") @db.VarChar(255)
  fileUrl       String    @map("file_url")
  fileSizeBytes Int       @default(0) @map("file_size_bytes")
  fileSize      Int       @default(0) @map("file_size")
  fileType      String    @default("application/pdf") @map("file_type") @db.VarChar(100)
  mimeType      String    @default("application/pdf") @map("mime_type") @db.VarChar(100)
  uploadedById  String?   @map("uploaded_by_id") @db.Uuid
  uploadedBy    Employee? @relation("DocUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  uploadedAt    DateTime  @default(now()) @map("uploaded_at")
  deletedAt     DateTime? @map("deleted_at")

  @@index([employeeId])
  @@map("employee_documents")
}

model EmployeeNote {
  id         String   @id @default(uuid()) @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation("EmployeeNotes", fields: [employeeId], references: [id], onDelete: Cascade)
  authorId   String   @map("author_id") @db.Uuid
  author     Employee @relation("EmployeeNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  body       String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([employeeId])
  @@map("employee_notes")
}

model EmployeeAssignment {
  id                 String   @id @default(uuid()) @db.Uuid
  staffEmployeeId    String   @map("staff_employee_id") @db.Uuid
  staffEmployee      Employee @relation("StaffAssignment", fields: [staffEmployeeId], references: [id], onDelete: Cascade)
  assignedEmployeeId String   @map("assigned_employee_id") @db.Uuid
  assignedEmployee   Employee @relation("AssignedToStaff", fields: [assignedEmployeeId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now()) @map("created_at")

  @@unique([staffEmployeeId, assignedEmployeeId])
  @@map("employee_assignments")
}

model EmployeeHistoryRecord {
  id          String              @id @default(uuid()) @db.Uuid
  employeeId  String              @map("employee_id") @db.Uuid
  employee    Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type        EmployeeHistoryType
  date        DateTime            @db.Date
  description String
  addedBy     String              @map("added_by") @db.VarChar(100)
  createdAt   DateTime            @default(now()) @map("created_at")

  @@index([employeeId])
  @@map("employee_history_records")
}

model EsslDevice {
  id         String              @id @default(uuid()) @db.Uuid
  deviceCode String              @unique @map("device_code") @db.VarChar(50)
  name       String              @db.VarChar(100)
  ipAddress  String?             @map("ip_address") @db.VarChar(50)
  location   String?             @db.VarChar(100)
  lastSyncAt DateTime?           @map("last_sync_at")
  isActive   Boolean             @default(true) @map("is_active")
  createdAt  DateTime            @default(now()) @map("created_at")

  mappings EsslDeviceMapping[]
  punches  AttendancePunch[]

  @@map("essl_devices")
}

model EsslDeviceMapping {
  id           String     @id @default(uuid()) @db.Uuid
  employeeId   String     @map("employee_id") @db.Uuid
  employee     Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  deviceId     String     @map("device_id") @db.Uuid
  device       EsslDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  biometricPin String     @map("biometric_pin") @db.VarChar(50)
  createdAt    DateTime   @default(now()) @map("created_at")

  @@unique([deviceId, biometricPin])
  @@map("essl_device_mappings")
}

model AttendanceRecord {
  id              String           @id @default(uuid()) @db.Uuid
  employeeId      String           @map("employee_id") @db.Uuid
  employee        Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date            DateTime         @db.Date
  status          AttendanceStatus @default(PRESENT)
  source          AttendanceSource @default(MANUAL)
  punchIn         DateTime?        @map("punch_in")
  punchOut        DateTime?        @map("punch_out")
  checkInDevice   String?          @map("check_in_device") @db.VarChar(100)
  approvalStatus  ApprovalStatus   @default(PENDING) @map("approval_status")
  rejectionReason String?          @map("rejection_reason")
  approverId      String?          @map("approver_id") @db.Uuid
  approvedAt      DateTime?        @map("approved_at")
  notes           String?
  hasException    Boolean          @default(false) @map("has_exception")
  exceptionType   String?          @map("exception_type") @db.VarChar(50)
  sourceEsslPunchIds String[]      @default([]) @map("source_essl_punch_ids")
  createdById     String?          @map("created_by_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  punches         AttendancePunch[]
  approvalHistory AttendanceApprovalHistory[]

  @@unique([employeeId, date])
  @@index([date])
  @@index([approvalStatus])
  @@map("attendance_records")
}

model EsslPunch {
  id                  String    @id @default(uuid()) @db.Uuid
  employeeId          String?   @map("employee_id") @db.Uuid
  deviceId            String    @map("device_id") @db.VarChar(50)
  externalBiometricId String?   @map("external_biometric_id") @db.VarChar(50)
  punchAt             DateTime  @map("punch_at")
  punchType           String    @default("UNKNOWN") @map("punch_type") @db.VarChar(20)
  rawPayload          Json      @map("raw_payload") @db.JsonB
  receivedAt          DateTime  @default(now()) @map("received_at")
  processedAt         DateTime? @map("processed_at")
  processingError     String?   @map("processing_error")

  @@unique([deviceId, externalBiometricId, punchAt])
  @@index([employeeId, punchAt])
  @@index([processedAt])
  @@index([deviceId, punchAt])
  @@map("essl_punches")
}

model AttendancePunch {
  id                 String            @id @default(uuid()) @db.Uuid
  attendanceRecordId String?           @map("attendance_record_id") @db.Uuid
  attendanceRecord   AttendanceRecord? @relation(fields: [attendanceRecordId], references: [id], onDelete: SetNull)
  employeeId         String            @map("employee_id") @db.Uuid
  deviceId           String?           @map("device_id") @db.Uuid
  device             EsslDevice?       @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  punchTime          DateTime          @map("punch_time")
  punchType          String            @map("punch_type") @db.VarChar(10)
  isException        Boolean           @default(false) @map("is_exception")
  exceptionReason    String?           @map("exception_reason")
  createdAt          DateTime          @default(now()) @map("created_at")

  @@index([employeeId, punchTime])
  @@map("attendance_punches")
}

model AttendanceApprovalHistory {
  id                 String           @id @default(uuid()) @db.Uuid
  attendanceRecordId String           @map("attendance_record_id") @db.Uuid
  attendanceRecord   AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)
  actorId            String?          @map("actor_id") @db.Uuid
  action             String           @db.VarChar(50)
  fromStatus         String?          @map("from_status") @db.VarChar(50)
  toStatus           String           @map("to_status") @db.VarChar(50)
  reason             String?
  createdAt          DateTime         @default(now()) @map("created_at")

  @@index([attendanceRecordId])
  @@map("attendance_approval_history")
}

model LeaveType {
  id                String             @id @default(uuid()) @db.Uuid
  code              String             @unique @db.VarChar(30)
  name              String             @db.VarChar(100)
  description       String?
  quotaDays         Decimal            @default(12) @map("quota_days") @db.Decimal(5, 1)
  isPaid            Boolean            @default(true) @map("is_paid")
  allowCarryForward Boolean            @default(false) @map("allow_carry_forward")
  isActive          Boolean            @default(true) @map("is_active")
  createdAt         DateTime           @default(now()) @map("created_at")

  applications      LeaveApplication[]
  balances          LeaveBalance[]

  @@map("leave_types")
}

model LeaveBalance {
  id             String    @id @default(uuid()) @db.Uuid
  employeeId     String    @map("employee_id") @db.Uuid
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId    String    @map("leave_type_id") @db.Uuid
  leaveType      LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  year           Int
  allocated      Decimal   @db.Decimal(5, 1)
  used           Decimal   @default(0) @db.Decimal(5, 1)
  carriedForward Decimal   @default(0) @map("carried_forward") @db.Decimal(5, 1)
  balance        Decimal   @db.Decimal(5, 1)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([employeeId, leaveTypeId, year])
  @@map("leave_balances")
}

model LeaveApplication {
  id              String                 @id @default(uuid()) @db.Uuid
  employeeId      String                 @map("employee_id") @db.Uuid
  employee        Employee               @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId     String                 @map("leave_type_id") @db.Uuid
  leaveType       LeaveType              @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  startDate       DateTime               @map("start_date") @db.Date
  endDate         DateTime               @map("end_date") @db.Date
  daysCount       Decimal                @map("days_count") @db.Decimal(4, 1)
  reason          String
  status          LeaveStatus            @default(PENDING)
  rejectionReason String?                @map("rejection_reason")
  approverId      String?                @map("approver_id") @db.Uuid
  approvedAt      DateTime?              @map("approved_at")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  approvalHistory LeaveApprovalHistory[]

  @@index([employeeId])
  @@index([status])
  @@map("leave_applications")
}

model LeaveApprovalHistory {
  id                 String           @id @default(uuid()) @db.Uuid
  leaveApplicationId String           @map("leave_application_id") @db.Uuid
  leaveApplication   LeaveApplication @relation(fields: [leaveApplicationId], references: [id], onDelete: Cascade)
  actorId            String?          @map("actor_id") @db.Uuid
  action             String           @db.VarChar(50)
  fromStatus         String?          @map("from_status") @db.VarChar(50)
  toStatus           String           @map("to_status") @db.VarChar(50)
  reason             String?
  createdAt          DateTime         @default(now()) @map("created_at")

  @@index([leaveApplicationId])
  @@map("leave_approval_history")
}

model SalaryRevision {
  id              String   @id @default(uuid()) @db.Uuid
  employeeId      String   @map("employee_id") @db.Uuid
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  effectiveFrom   DateTime @map("effective_from") @db.Date
  revisionNumber  Int      @map("revision_number")
  baseSalary      Decimal  @map("base_salary") @db.Decimal(12, 2)
  components      Json     @db.JsonB
  grossSalary     Decimal  @map("gross_salary") @db.Decimal(12, 2)
  totalDeductions Decimal  @map("total_deductions") @db.Decimal(12, 2)
  netSalary       Decimal  @map("net_salary") @db.Decimal(12, 2)
  savedById       String?  @map("saved_by_id") @db.Uuid
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")

  componentsList  SalaryComponent[]

  @@index([employeeId, effectiveFrom])
  @@map("salary_revisions")
}

model SalaryComponent {
  id               String         @id @default(uuid()) @db.Uuid
  salaryRevisionId String         @map("salary_revision_id") @db.Uuid
  salaryRevision   SalaryRevision @relation(fields: [salaryRevisionId], references: [id], onDelete: Cascade)
