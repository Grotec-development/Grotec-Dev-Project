  status         String            @default("ACTIVE") @db.VarChar(20)
  issuedAt       DateTime          @default(now()) @map("issued_at")
  createdAt      DateTime          @default(now()) @map("created_at")

  recoveries     AdvanceRecovery[]

  @@index([employeeId])
  @@map("advance_ledger")
}

model AdvanceRecovery {
  id                 String        @id @default(uuid()) @db.Uuid
  advanceId          String        @map("advance_id") @db.Uuid
  advance            AdvanceLedger @relation(fields: [advanceId], references: [id], onDelete: Cascade)
  payrollRunId       String?       @map("payroll_run_id") @db.Uuid
  amount             Decimal       @db.Decimal(12, 2)
  linkedPayrollMonth String?       @map("linked_payroll_month") @db.VarChar(7)
