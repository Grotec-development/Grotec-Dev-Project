}

model PayrollRun {
  id              String            @id @default(uuid()) @db.Uuid
  month           String            @unique @db.VarChar(7)
  status          PayrollStatus     @default(IDLE)
  totalEmployees  Int               @default(0) @map("total_employees")
  totalGross      Decimal           @default(0) @map("total_gross") @db.Decimal(14, 2)
  totalDeductions Decimal           @default(0) @map("total_deductions") @db.Decimal(14, 2)
  totalNet        Decimal           @default(0) @map("total_net") @db.Decimal(14, 2)
  generatedById   String?           @map("generated_by_id") @db.Uuid
  generatedAt     DateTime?         @map("generated_at")
  approverId      String?           @map("approver_id") @db.Uuid
  approvedAt      DateTime?         @map("approved_at")
  publishedById   String?           @map("published_by_id") @db.Uuid
  publishedAt     DateTime?         @map("published_at")
  notes           String?
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  lineItems       PayrollLineItem[]

  @@map("payroll_runs")
}

model PayrollLineItem {
  id                         String     @id @default(uuid()) @db.Uuid
  payrollRunId               String     @map("payroll_run_id") @db.Uuid
  payrollRun                 PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employeeId                 String     @map("employee_id") @db.Uuid
  employee                   Employee   @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  effectiveSalaryRevisionId  String?    @map("effective_salary_revision_id") @db.Uuid
  grossEarnings              Decimal    @map("gross_earnings") @db.Decimal(12, 2)
  totalDeductions            Decimal    @map("total_deductions") @db.Decimal(12, 2)
  workingDays                Int        @default(30) @map("working_days")
  presentDays                Decimal    @default(0) @map("present_days") @db.Decimal(4, 1)
  absentDays                 Decimal    @default(0) @map("absent_days") @db.Decimal(4, 1)
  halfDays                   Decimal    @default(0) @map("half_days") @db.Decimal(4, 1)
  attendanceAdjustment       Decimal    @default(0) @map("attendance_adjustment") @db.Decimal(12, 2)
  advanceRecovery            Decimal    @default(0) @map("advance_recovery") @db.Decimal(12, 2)
  netPay                     Decimal    @map("net_pay") @db.Decimal(12, 2)
  components                 Json       @db.JsonB
  flags                      String[]
  createdAt                  DateTime   @default(now()) @map("created_at")

  @@unique([payrollRunId, employeeId])
  @@map("payroll_line_items")
}

model KpiMetricDefinition {
  id         String   @id @default(uuid()) @db.Uuid
  code       String   @unique @db.VarChar(50)
  name       String   @db.VarChar(100)
  isActive   Boolean  @default(true) @map("is_active")
  sourceNote String?  @map("source_note")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("kpi_metric_definitions")
}

model KpiTarget {
  id          String        @id @default(uuid()) @db.Uuid
  employeeId  String?       @map("employee_id") @db.Uuid
  employee    Employee?     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  teamId      String?       @map("team_id") @db.VarChar(100)
  roleCode    String?       @map("role_code") @db.VarChar(30)
  team        String?       @db.VarChar(100)
  period      String        @db.VarChar(7)
  metric      KpiMetricType
  targetValue Decimal       @map("target_value") @db.Decimal(12, 2)
  weight      Decimal       @default(1) @db.Decimal(5, 2)
  createdById String?       @map("created_by_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at")

  @@index([period, employeeId])
  @@map("kpi_targets")
}

model KpiScore {
  id                 String   @id @default(uuid()) @db.Uuid
  employeeId         String   @map("employee_id") @db.Uuid
  period             String   @db.VarChar(7)
  metricCode         String   @map("metric_code") @db.VarChar(50)
  actualValue        Decimal  @map("actual_value") @db.Decimal(12, 2)
  targetValue        Decimal  @map("target_value") @db.Decimal(12, 2)
  achievementPercent Decimal  @map("achievement_percent") @db.Decimal(6, 2)
  computedAt         DateTime @default(now()) @map("computed_at")

  @@unique([employeeId, period, metricCode])
  @@map("kpi_scores")
}

model KpiPeriodScore {
  id                     String           @id @default(uuid()) @db.Uuid
  employeeId             String           @map("employee_id") @db.Uuid
  employee               Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  period                 String           @db.VarChar(7)
  actualValues           Json             @map("actual_values") @db.JsonB
  targetValues           Json             @map("target_values") @db.JsonB
  weights                Json             @db.JsonB
  achievementPercentages Json             @map("achievement_percentages") @db.JsonB
  overallScore           Decimal          @map("overall_score") @db.Decimal(5, 2)
  performanceStatus      String           @map("performance_status") @db.VarChar(50)
  reviewNotes            String?          @map("review_notes")
  coachingActions        String?          @map("coaching_actions")
  isFrozen               Boolean          @default(false) @map("is_frozen")
  computedAt             DateTime         @default(now()) @map("computed_at")
  frozenAt               DateTime?        @map("frozen_at")

  reviewEntries          KpiReviewEntry[]

  @@unique([employeeId, period])
  @@map("kpi_period_scores")
}

model KpiReviewEntry {
  id               String         @id @default(uuid()) @db.Uuid
  kpiPeriodScoreId String         @map("kpi_period_score_id") @db.Uuid
  kpiPeriodScore   KpiPeriodScore @relation(fields: [kpiPeriodScoreId], references: [id], onDelete: Cascade)
  authorId         String         @map("author_id") @db.Uuid
  body             String         @db.Text
  createdAt        DateTime       @default(now()) @map("created_at")

  @@index([kpiPeriodScoreId])
  @@map("kpi_review_entries")
}

model AppNotification {
  id          String           @id @default(uuid()) @db.Uuid
  recipientId String           @map("recipient_id") @db.Uuid
  recipient   Employee         @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  type        NotificationType
  title       String           @db.VarChar(200)
  message     String
  data        Json?            @db.JsonB
  isRead      Boolean          @default(false) @map("is_read")
  createdAt   DateTime         @default(now()) @map("created_at")

  @@index([recipientId, isRead])
  @@map("app_notifications")
}

