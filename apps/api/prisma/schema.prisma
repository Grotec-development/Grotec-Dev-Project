// GROTEC FarmerOS CRM — Month 1 foundation schema.
// Conventions: UUID PKs, snake_case columns, timestamptz timestamps,
// soft delete via deleted_at on business records, append-only ownership/audit rows.
// Partial unique indexes (active-row uniqueness) are added via raw SQL in the
// init migration — Prisma schema cannot express partial indexes.
// See docs/database.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums (mirrored in packages/shared/src/enums.ts)
// ---------------------------------------------------------------------------

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum PhoneKind {
  MOBILE
  OTHER
}

// Provisional vocabulary — reconciled with the Month 3 call-outcome flow
// (docs/open-items.md #5).
enum LeadStatus {
  OPEN
  CLOSED
}

// ---------------------------------------------------------------------------
// Identity & RBAC
// ---------------------------------------------------------------------------

// Single shared employee identity (future HRMS extends this table; it is never
// duplicated into a CRM-only user table). Emails are stored lowercase.
model Employee {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(255)
  fullName     String   @map("full_name")
  phone        String?  @db.VarChar(20)
  passwordHash String   @map("password_hash")
  roleId       String   @map("role_id") @db.Uuid
  role         Role     @relation(fields: [roleId], references: [id])
  status       EmployeeStatus @default(ACTIVE)
  lastLoginAt  DateTime? @map("last_login_at")
  createdById  String?  @map("created_by") @db.Uuid
  createdBy    Employee? @relation("EmployeeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  createdEmployees  Employee[]       @relation("EmployeeCreatedBy")
  createdCustomers  Customer[]       @relation("CustomerCreatedBy")
  sessions          AuthSession[]
  audits            AuditEvent[]
  heldLeadOwnerships LeadOwnership[]  @relation("LeadOwnershipHolder")
  assignedLeadOwnerships LeadOwnership[] @relation("LeadOwnershipAssignedBy")

  @@map("employees")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(30)
  name        String   @db.VarChar(100)
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  employees      Employee[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(100)
  module      String   @db.VarChar(60)
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// Refresh-token store. Tokens are stored hashed; rotation revokes the old row.
model AuthSession {
  id         String   @id @default(uuid()) @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tokenHash  String   @map("token_hash")
  expiresAt  DateTime @map("expires_at")
  ip         String?
  userAgent  String?  @map("user_agent")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([employeeId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

// ---------------------------------------------------------------------------
// Farmer master
// ---------------------------------------------------------------------------

model Customer {
  id         String         @id @default(uuid()) @db.Uuid
  // Unique Farmer ID (developer brief farmer-master list) — e.g. GF00000042,
  // generated from farmer_code_seq. Nullable only for pre-alignment rows.
  farmerCode String?        @unique @map("farmer_code") @db.VarChar(20)
  fullName   String         @map("full_name")
  status     CustomerStatus @default(ACTIVE)
  // Preferred language is provisional; vocabulary TBD (open item).
  preferredLanguage String? @map("preferred_language") @db.VarChar(10)
  createdById String?       @map("created_by") @db.Uuid
  createdBy  Employee?      @relation("CustomerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  deletedAt  DateTime?      @map("deleted_at")

  phones    CustomerPhone[]
  locations CustomerLocation[]
  crops     CustomerCrop[]
  leads     Lead[]

  @@index([fullName])
  @@map("customers")
}

model CustomerPhone {
  id         String    @id @default(uuid()) @db.Uuid
  customerId String    @map("customer_id") @db.Uuid
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  phoneE164  String    @map("phone_e164") @db.VarChar(20)
  rawInput   String?   @map("raw_input")
  kind       PhoneKind @default(MOBILE)
  isPrimary  Boolean   @default(false) @map("is_primary")
  createdById String?  @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  @@index([customerId])
  @@map("customer_phones")
}

model CustomerLocation {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  addressLine String? @map("address_line")
  state      String?
  district   String?
  taluk      String?
  village    String?
  pincode    String?
  latitude   Decimal? @db.Decimal(9, 6)
  longitude  Decimal? @db.Decimal(9, 6)
  isPrimary  Boolean  @default(false) @map("is_primary")
  createdById String? @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  @@index([customerId])
  @@map("customer_locations")
}

model Crop {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(40)
  name        String   @db.VarChar(120)
  localName   String?  @map("local_name")
  isActive    Boolean  @default(true) @map("is_active")
  createdById String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  customerCrops CustomerCrop[]

  @@map("crops")
}

model CustomerCrop {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  cropId     String   @map("crop_id") @db.Uuid
  crop       Crop     @relation(fields: [cropId], references: [id], onDelete: Restrict)
  acreage    Decimal  @db.Decimal(12, 2)
  unit       String   @default("acre") @db.VarChar(20)
  notes      String?
  createdById String? @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  @@index([customerId])
  @@index([cropId])
  @@map("customer_crops")
}

// ---------------------------------------------------------------------------
// Leads + agent ownership
// ---------------------------------------------------------------------------

model Lead {
  id         String     @id @default(uuid()) @db.Uuid
  customerId String     @map("customer_id") @db.Uuid
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  source     String?    // taxonomy provisional (open-item #5)
  status     LeadStatus @default(OPEN)
  notes      String?
  createdById String?   @map("created_by") @db.Uuid
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  deletedAt  DateTime?  @map("deleted_at")

  ownerships LeadOwnership[]

  @@index([customerId])
  @@index([status])
  @@map("leads")
}

// Agent ownership history. A lead has exactly one CURRENT owner (partial unique
// index on released_at IS NULL — added in the init migration). Rows are never
// deleted. Distinct concept from relationship ownership (RM, Month 4).
model LeadOwnership {
  id           String   @id @default(uuid()) @db.Uuid
  leadId       String   @map("lead_id") @db.Uuid
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Restrict)
  employeeId   String   @map("employee_id") @db.Uuid
  employee     Employee @relation("LeadOwnershipHolder", fields: [employeeId], references: [id], onDelete: Restrict)
  assignedById String   @map("assigned_by") @db.Uuid
  assignedBy   Employee @relation("LeadOwnershipAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)
  reason       String?
  assignedAt   DateTime @default(now()) @map("assigned_at")
  releasedAt   DateTime? @map("released_at")

  @@index([leadId])
  @@index([employeeId])
  @@map("lead_ownership")
}

// ---------------------------------------------------------------------------
// Audit (append-only)
// ---------------------------------------------------------------------------

model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  actorId     String?  @map("actor_id") @db.Uuid
  actor       Employee? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  entityType  String   @map("entity_type") @db.VarChar(60)
  entityId    String?  @map("entity_id") @db.Uuid
  entityLabel String?  @map("entity_label")
  action      String   @db.VarChar(60)
  before      Json?    @db.JsonB
  after       Json?    @db.JsonB
  meta        Json?    @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("audit_events")
}
