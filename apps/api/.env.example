# --- Database -----------------------------------------------------------
# Same URLs for Docker Compose (Postgres 16) and embedded fallback (Postgres 18).
DATABASE_URL="postgresql://grotec:grotec@localhost:5432/grotec"
TEST_DATABASE_URL="postgresql://grotec:grotec@localhost:5432/grotec_test"

# --- HTTP ---------------------------------------------------------------
PORT=3000
# Comma-separated origins allowed to call the API in dev (Vite proxy avoids CORS in prod).
CORS_ORIGINS="http://localhost:5173"

# --- Auth ---------------------------------------------------------------
# HS256 secret for short-lived access tokens. Use a long random value in any real env.
JWT_ACCESS_SECRET="dev-only-change-me-access-secret"
ACCESS_TOKEN_TTL_SECONDS=900            # 15 minutes
REFRESH_TOKEN_TTL_DAYS=30
# httpOnly refresh cookie. Must be true behind HTTPS in production.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# --- Login rate limiting -------------------------------------------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# --- Auto-dialer (Month 2) — vendor-neutral mock by default ---------------
# DIALER_PROVIDER selects the adapter behind the internal abstraction.
DIALER_PROVIDER=mock
# Mock simulator behaviour only (real vendors bring their own timings):
DIALER_RING_MS=4000                # DIALING -> RINGING
DIALER_CONNECT_MS=800              # RINGING -> CONNECTED/NOT_ANSWERED
DIALER_ANSWER_RATE=1               # 0..1 probability a mock call connects
DIALER_SYNC_MS=1500                # background status-poll interval (0 disables)
DIALER_WEBHOOK_SECRET="dev-webhook-secret-change-me"

# --- AI Assistant (Month 2 feature: replaces the Knowledge Base screen) ---
# The assistant retrieves crop/product guidance and calls an OpenAI-compatible
# chat-completions endpoint. Leave LLM_API_KEY empty in dev: the chat answers
# "assistant unavailable" gracefully instead of crashing.
LLM_API_KEY=""
LLM_BASE_URL="https://api.openai.com/v1"
LLM_MODEL="gpt-4o-mini"

# --- Seed (dev) ---------------------------------------------------------
FOUNDER_EMAIL="founder@grotec.local"
FOUNDER_NAME="Grotec Founder"
FOUNDER_PASSWORD="Founder@123"
# Comma-separated demo employees: name,email,roleCode
SEED_EMPLOYEES="Manager One,manager@grotec.local,MANAGER;Agent One,agent@grotec.local,AGENT;Staff One,staff@grotec.local,STAFF"
